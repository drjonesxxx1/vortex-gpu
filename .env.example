# VortexGPU — gateway configuration
#
# Copy to .env and fill in. systemd loads this via EnvironmentFile, so values
# are taken literally: do NOT quote them, and a value may contain spaces.
# Keep .env at mode 600 — it holds every secret the gateway has.

# ---- Core ----
PORT=3000

# Hidden admin token. Gates /admin and every /api/admin/* route.
# Generate: openssl rand -hex 24
ADMIN_TOKEN=<generate-with-openssl-rand-hex-24>

# Shared secret the GPU node agents present as X-NODE-SECRET.
# Generate: openssl rand -hex 24
NODE_SECRET=<generate-with-openssl-rand-hex-24>

# Password for the seeded owner account (username: drjones, unlimited).
# If unset, the seed is SKIPPED rather than falling back to a baked-in
# password. Only used when the account does not already exist.
OWNER_SEED_PASSWORD=

# ---- Proxmox hypervisor (full VM provisioning) ----
# The gateway reaches this over SSH as PVE_USER and runs `qm`, so the gateway
# host needs key-based SSH access to it.
PVE_HOST=10.30.20.85
PVE_USER=root
PVE_TEMPLATE_WIN=504      # must be a template (template: 1)
PVE_TEMPLATE_LINUX=990    # must be a template (template: 1)

# What tenants are told each template produces. The UI reads these from
# /api/health instead of hardcoding a version, so swapping a template above is
# a config change, not a code change — but you MUST update the matching label
# or the storefront advertises an OS you no longer ship.
#
#   swapping the Windows template:
#     1. build the new template on Proxmox, note its VMID
#     2. set PVE_TEMPLATE_WIN=<new vmid> and WINDOWS_LABEL=<what it is>
#     3. bash deploy.sh   (restart picks up both)
#
# Leave a label unset to fall back to the bare "Windows" / "Linux".
WINDOWS_LABEL=Windows
LINUX_LABEL=Linux
PVE_VMID_START=2000

# ---- BTCPay (real payments) ----
BTCPAY_URL=https://10.30.20.140
BTCPAY_API_KEY=<your-btcpay-api-key>
BTCPAY_STORE_ID=<your-btcpay-store-id>
BTCPAY_PUBLIC=https://btcpay.example.com
BTCPAY_WEBHOOK_SECRET=<your-btcpay-webhook-secret>

# REQUIRED — the gateway refuses to start without BTCPAY_WEBHOOK_SECRET, rather
# than falling back to a default that would let anyone forge a paid invoice.

# Credit balance on BTCPay's InvoiceProcessing (payment SEEN but NOT confirmed)
# as well as InvoiceSettled. Off by default: crediting on Processing grants GPU
# time against a transaction that can still be replaced or double-spent.
# Set to 1 to trade that risk for faster credit.
CREDIT_ON_PROCESSING=0

# ---- Pricing / limits ----
# Hardware label shown to tenants. Set this to the GPU you ACTUALLY provide —
# tenants are paying for it, and advertising hardware you do not have is
# misrepresentation, not marketing.
GPU_SKU=NVIDIA GeForce RTX 4080 SUPER 16GB

# Concurrent machines per account that are never billed.
FREE_MACHINES=1

# ---- GPU session capacity ----
# The single Linux node running the docker/noVNC session agent. Health and the
# spawn preflight both read this, so they cannot disagree.
SESSION_NODE=nightmare

# Free VRAM (MiB) required before a GPU session is handed out. The node reports
# real nvidia-smi figures; below this, spawn returns 503 and charges nothing,
# instead of giving a tenant a "GPU machine" that cannot compute.
# Set 0 to disable the preflight entirely.
MIN_FREE_VRAM_MB=2048

# ---- Session egress proxies (tier 1: operator-run VPN boxes) ----
# Tier 1 is exactly what you list here: boxes YOU run, each with a VPN client
# plus a proxy listener, so traffic through the proxy egresses via the VPN.
# These are always preferred — a tier 2 fallback exit (below) is handed out only
# when NOT ONE tier 1 box is verified clean.
#
# Comma-separated proxy URLs, handed verbatim to the node agent. http://,
# https://, socks5:// and socks5h:// are supported; the port may be omitted
# (3128 for http/https, 1080 for socks5).
PROXY_ENDPOINTS=http://10.30.20.71:3128,http://10.30.20.154:3128,http://10.30.20.189:3128

# IPs that must NEVER be a session's egress — above all the operator's own
# WAN/home address. THIS IS THE WHOLE SAFETY CHECK: a box whose VPN has dropped
# keeps accepting proxy connections and serves traffic from the home IP, so
# "the proxy responded" proves nothing. An endpoint is healthy only when a probe
# through it returned a valid IP that is NOT in this list. This applies
# IDENTICALLY to tier 1 and tier 2 — the fallback has no weaker path.
# LEAVING THIS UNSET MEANS THE CHECK CANNOT RUN, so nothing is ever marked
# healthy and (with REQUIRE_CLEAN_PROXY=1) every session spawn is refused.
PROXY_FORBIDDEN_EGRESS=203.0.113.10

# 1 (default) = fail CLOSED: if no endpoint is verified clean, /api/session/spawn
# returns 503 and creates nothing, rather than starting a session that egresses
# from the operator's own IP. Set 0 ONLY to deliberately allow un-proxied
# sessions — it re-enables the old fail-open behaviour.
REQUIRE_CLEAN_PROXY=1

# Egress-IP echo service fetched THROUGH each proxy. Must answer with a bare IP.
PROXY_CHECK_URL=https://api.ipify.org

# Per-probe timeout (ms) and how often the whole pool is re-probed (ms). Both
# tiers use these. The timeout is deliberately short: a box whose VPN wedged must
# not stall the loop, and neither must a dead public proxy.
PROXY_CHECK_TIMEOUT_MS=6000
PROXY_REFRESH_MS=300000

# ---- Session egress proxies (tier 2: PUBLIC FALLBACK — read this before use) ----
# 0 (default) = off. Tier 1 is the whole pool and a simultaneous outage of your
# VPN boxes refuses every spawn (which is what happened, and why this exists).
#
# 1 = when NOT ONE tier 1 box is verified clean, sessions may be assigned a proxy
# from the free public list below instead of being refused.
#
# WHAT YOU ARE ACCEPTING BY SETTING THIS TO 1: these are strangers' machines.
# Whoever runs one can read and modify every unencrypted byte a tenant sends
# through it, can see the destination of every TLS connection they make, and may
# be running it for exactly that purpose. You are buying availability with your
# tenants' confidentiality. Nothing here can detect a proxy that is behaving
# correctly and logging everything.
#
# WHAT IS STILL GUARANTEED: a tier 2 proxy must pass the SAME probe as your own
# boxes — a valid egress IP that is not in PROXY_FORBIDDEN_EGRESS — before it can
# be assigned, tier 1 is always exhausted first, and if neither tier has a clean
# exit the spawn is still refused with 503 (REQUIRE_CLEAN_PROXY=1). Which tier is
# in use is visible per-endpoint in /api/admin/state and logged on every switch;
# it is never shown to tenants or to unauthenticated callers.
PROXY_FALLBACK_ENABLED=0

# Where the fallback list is fetched from (fetched DIRECTLY, not through a
# proxy). Expects the Proxifly JSON shape (a list of {proxy} / {ip,port,protocol}
# objects); a plain newline list of host:port also works. A fetch that 404s,
# times out, exceeds 4 MB or parses to nothing is logged and IGNORED — the
# previously probed fallback pool stays in place rather than being emptied.
PROXY_FALLBACK_SOURCE=https://cdn.jsdelivr.net/gh/proxifly/free-proxy-list@main/proxies/countries/US/data.json

# How many candidates from that list are probed per refresh. The upstream list
# has run to 677 entries; probing all of them would make one refresh outlive its
# own PROXY_REFRESH_MS interval. Probes run 8 at a time, so the cap below costs
# roughly (PROXY_FALLBACK_MAX / 8) * PROXY_CHECK_TIMEOUT_MS in the worst case.
PROXY_FALLBACK_MAX=25

# ---- Auth ----
# Bearer token lifetime (ms). Default 7 days. Tokens are in-memory only, so a
# restart logs everyone out regardless.
AUTH_TOKEN_TTL_MS=604800000

# Express `trust proxy`. Default trusts loopback + private ranges, so an
# upstream proxy's X-Forwarded-For is honored while a direct client cannot
# forge it. Accepts a hop count, true/false, or a CSV of subnets/shorthands.
# WRONG VALUES ARE DANGEROUS: `true` lets anyone spoof their rate-limit key;
# `false` behind a proxy buckets every user together and locks them out.
TRUST_PROXY=loopback, linklocal, uniquelocal

# ---- Optional free-tier abuse cap ----
# Max unbilled machines one source IP may take per window. 0 = disabled.
# Enabling affects users sharing an egress IP (CGNAT, office, VPN), so pick the
# threshold deliberately. Paying and unlimited accounts are never counted.
FREE_MACHINE_IP_LIMIT=0
FREE_MACHINE_IP_WINDOW_MS=86400000

# ---- Housekeeping intervals ----
# Drop GPU nodes that have not reported in this long (ms). Default 7 days.
NODE_STALE_MS=604800000

# How often to re-read the hypervisor and correct drifted vm rows (ms).
# Only ever updates state; never deletes a row, never changes the host.
VM_RECONCILE_MS=300000
